<!-- Marca de Stocky: tarro de despensa con niveles de existencias y una hoja. -->
<g id="mark">
  <!-- hoja -->
  <path d="M600 214 C 640 120, 760 96, 812 120 C 806 196, 724 268, 618 262 Z" fill="LEAF"/>
  <path d="M620 258 C 676 214, 726 178, 790 132" stroke="LEAFVEIN" stroke-width="14" stroke-linecap="round" fill="none"/>
  <!-- tapa -->
  <rect x="356" y="236" width="312" height="84" rx="34" fill="JAR"/>
  <!-- cuerpo -->
  <rect x="292" y="300" width="440" height="500" rx="120" fill="JAR"/>
  <!-- niveles -->
  <rect x="380" y="430" width="264" height="58" rx="29" fill="BAR1"/>
  <rect x="380" y="530" width="200" height="58" rx="29" fill="BAR2"/>
  <rect x="380" y="630" width="140" height="58" rx="29" fill="BAR3"/>
</g>
