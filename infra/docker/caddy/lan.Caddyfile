# Modo RED LOCAL (IP): HTTP sin cifrar, pensado solo para la wifi de casa.
# No abras este puerto en el router: desde Internet usa el modo dominio (HTTPS).
# La conexión entre la API y PostgreSQL sigue cifrada (TLS 1.3) y los datos
# del inventario se guardan cifrados en la base de datos.
{
	admin off
	auto_https off
	servers {
		# Si delante hay otro proxy (Nginx Proxy Manager, un túnel…), solo se cree la IP
		# del cliente que manda ese proxy (STOCKY_TRUSTED_PROXIES en .env). Cualquier otro
		# X-Forwarded-For se ignora: así nadie se salta el límite de intentos fingiendo IPs.
		trusted_proxies static {$STOCKY_TRUSTED_PROXIES}
		trusted_proxies_strict
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

:80 {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000 {
			# Una sola IP, ya comprobada por Caddy (la API se fía de este valor).
			header_up X-Forwarded-For {client_ip}
			header_up -X-Forwarded-Host
		}
	}

	handle {
		respond 404
	}
}
