# Modo DOMINIO: HTTPS automático con Let's Encrypt delante de la API.
# Requiere que el dominio apunte a este servidor y los puertos 80 y 443 abiertos.
{
	email {$ACME_EMAIL}
	# Sin panel de administración expuesto.
	admin off
}

(api) {
	encode zstd gzip

	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Solo se publica la API; cualquier otra ruta responde 404.
	handle /api/* {
		reverse_proxy api:8000 {
			header_up -X-Forwarded-Host
		}
	}

	handle {
		respond 404
	}
}

{$STOCKY_ADDRESS} {
	import api
}
