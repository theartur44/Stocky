# Configuración del servidor de Stocky. La crea ./stocky.sh la primera vez;
# puedes editarla a mano y aplicar los cambios con ./stocky.sh reiniciar.
# .env NO se sube a git. Los secretos van en ./secrets (los genera stocky.sh).

# Dirección con la que los móviles llegan al servidor:
#  - un dominio que apunte a este servidor (stocky.midominio.com): HTTPS automático, sirve desde fuera de casa;
#  - o la IP del servidor en tu red local (192.168.1.50): HTTP, solo dentro de la wifi de casa.
STOCKY_ADDRESS=192.168.1.50

# domain | lan  (stocky.sh lo deduce de STOCKY_ADDRESS)
STOCKY_MODE=lan

# Solo en modo dominio: correo para Let's Encrypt (avisos del certificado).
ACME_EMAIL=

# Puertos publicados en el servidor (cámbialos si ya están ocupados, p. ej. 8080).
STOCKY_HTTP_PORT=80
STOCKY_HTTPS_PORT=443

# Alta de cuentas: invite_code (recomendado, con el código de ./secrets/registration_code) | open | closed
STOCKY_REGISTRATION=invite_code
