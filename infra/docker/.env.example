# Copia este fichero a .env y rellénalo. .env NO se sube a git.
# Los secretos NO van aquí: están en ./secrets (scripts/generate-secrets.sh).

# Dominio público que apunta a este servidor (registro DNS A/AAAA).
STOCKY_DOMAIN=stocky.example.org
# Correo para Let's Encrypt (avisos de caducidad del certificado).
ACME_EMAIL=admin@example.org
# invite_code (recomendado) | open | closed
STOCKY_REGISTRATION=invite_code
